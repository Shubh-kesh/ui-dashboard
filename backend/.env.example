# ui-dashboard backend configuration (copy to .env for local dev).

# DEV = read MSSQL_USERNAME/MSSQL_PASSWORD below. Any other value (e.g. UAT)
# = fetch both from GCP Secret Manager using the GCP_* knobs at the bottom.
ENVIRONMENT=DEV

# Direct MSSQL connection (no uidb proxy). Local default = Azure SQL Edge.
MSSQL_SERVER=localhost,1433
MSSQL_DATABASE=docai
MSSQL_USERNAME=sa
MSSQL_PASSWORD=LocalDev123!
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Catalog tables: recent data lives in LIVE_PHOTO_TABLE, older data in the
# archive table. LIVE_WINDOW_DAYS is the age beyond which the UI auto-selects
# the archive table.
LIVE_PHOTO_TABLE=LIVE_PHOTO_LOGS
LIVE_PHOTO_ARCHIVE_TABLE=LIVE_PHOTO_LOGS_ARCHIVE
LIVE_WINDOW_DAYS=7

# GCP Secret Manager (only used when ENVIRONMENT != DEV). The pod/GKE node
# service account needs roles/secretmanager.secretAccessor on these secrets.
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1
MSSQL_USERNAME_SECRET_ID=sm-aikyc-uat-db-username
MSSQL_PASSWORD_SECRET_ID=sm-aikyc-uat-db-password
